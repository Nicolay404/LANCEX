# Copia a backend/.env. No subir valores reales a Git.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
APP_ENV=local
# Nombre corto de quien ejecuta este backend (aparece en los logs de Firestore)
DEV_NAME=

# Supabase PostgreSQL compartido: cadena del pooler en modo SESIÓN, usuario lancex_app.<REF>
# Nunca usar aquí la contraseña de postgres.
DATABASE_URL=
DB_SCHEMA=lancex

# PostgreSQL local para pruebas (Docker), con los SQL de supabase/migrations aplicados
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/lancex_test

# Firebase / Firestore (logs técnicos)
FIRESTORE_LOGS_ENABLED=true
FIREBASE_PROJECT_ID=
# Ruta ABSOLUTA al JSON de la cuenta de servicio, fuera del repositorio
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_LOG_COLLECTION=logs_tecnicos
FIRESTORE_LOG_MIN_LEVEL=WARNING
FIRESTORE_LOG_TTL_DAYS=30

# Supabase Storage (imágenes; solo backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGES_BUCKET=listing-images
