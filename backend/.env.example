# Copia a backend/.env. No subir valores reales a Git.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
APP_ENV=local
# Nombre corto de quien ejecuta este backend (aparece en los logs de Firestore)
DEV_NAME=

# Supabase PostgreSQL compartido: cadena del pooler en modo SESIÓN, usuario lancex_app.<REF>
# Nunca usar aquí la contraseña de postgres.
DATABASE_URL=
DB_SCHEMA=lancex
DB_SSLMODE=require
# Segundos que se reutiliza una conexión. 0 con runserver (si no, agota el pooler: EMAXCONNSESSION).
DB_CONN_MAX_AGE=0
# Sirve /api/v1/schema/ (OpenAPI). Por defecto igual a DJANGO_DEBUG.
LANCEX_SERVE_SCHEMA=true

# PostgreSQL local para pruebas (Docker), con los SQL de supabase/migrations aplicados
TEST_DATABASE_URL=postgres://lancex_app:lancex_app@localhost:54329/lancex_test

# Firebase / Firestore (logs técnicos). Si está en true sin credencial, la app sigue solo con consola.
# Verificar el envío real con: python manage.py emit_test_log
FIRESTORE_LOGS_ENABLED=true
FIREBASE_PROJECT_ID=
# Ruta ABSOLUTA al JSON de la cuenta de servicio, fuera del repositorio
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_LOG_COLLECTION=logs_tecnicos
FIRESTORE_LOG_MIN_LEVEL=WARNING
FIRESTORE_LOG_TTL_DAYS=30

# Supabase Storage (imágenes; solo backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket PRIVADO (sin acceso público)
SUPABASE_IMAGES_BUCKET=listing-images
